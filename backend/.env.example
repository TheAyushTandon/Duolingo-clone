# --- Environment ---
# development | testing | production
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# SQLite for development; swap for PostgreSQL later, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/duolingo_clone
DATABASE_URL=sqlite:///./data/duolingo_clone.db

# --- Security ---
# HMAC signing key for bearer tokens. MUST be changed in production.
SECRET_KEY=dev-only-insecure-secret-key-change-me

# Comma-separated allowed CORS origins (required in production).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Rate limiting (per-IP, in-memory) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL=100/minute
RATE_LIMIT_SUBMISSION=30/minute
RATE_LIMIT_COMPLETION=10/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_DEV=20/minute

# --- Gamification ---
HEART_REGENERATION_MINUTES=30
DEFAULT_MAX_HEARTS=5
# Gem economy
HEART_REFILL_GEM_COST=350
LESSON_COMPLETION_GEM_REWARD=5
ACHIEVEMENT_GEM_REWARD=10

# --- Demo account (seeded) ---
DEMO_USERNAME=demo_learner
DEMO_PASSWORD=duolingo123

# --- Development-only endpoints (/api/v1/dev/*). Never in production. ---
ENABLE_DEV_TOOLS=true
